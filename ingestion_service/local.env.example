APP_NAME=finzer-ingestion-service
ENVIRONMENT=local

# Local persistent infrastructure
DATABASE_URL=postgresql://finzer@127.0.0.1:5433/finzer
RABBITMQ_URL=amqp://finzer:finzer_local_password@127.0.0.1:5672/%2Ffinzer

# News discovery
NEWSDATA_API_KEY=<YOUR_NEWSDATA_API_KEY>
NEWSDATA_BASE_URL=https://newsdata.io/api/1/latest
MAX_PAGES_PER_FEED=3
MAX_ARTICLES_PER_FEED=20

# AI provider routing
# Generation can fail over per request. Embeddings select one healthy provider
# when the embedding worker starts and lock it for that worker session.
GENERATOR_PROVIDER=auto
GENERATOR_PRIMARY=bedrock
GENERATOR_FALLBACK=openai
EMBEDDING_PROVIDER=auto
EMBEDDING_PRIMARY=bedrock
EMBEDDING_FALLBACK=openai

# Amazon Bedrock
AWS_REGION=us-east-1
BEDROCK_API_KEY=<YOUR_BEDROCK_API_KEY>
BEDROCK_LLM_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_LLM_MODEL=openai.gpt-oss-120b
BEDROCK_LLM_TIMEOUT=300
BEDROCK_LLM_MAX_RETRIES=2
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# OpenAI fallback
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_LLM_MODEL=gpt-5.6-luna
OPENAI_LLM_TIMEOUT=120
OPENAI_LLM_MAX_RETRIES=2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Shared analysis / embedding settings
BEDROCK_LLM_MAX_TOKENS=1000
BEDROCK_LLM_TEMPERATURE=0.0
LLM_MAX_ARTICLE_CHARS=18000
ARTICLE_RELEVANCE_THRESHOLD=0.65
EMBEDDING_DIMENSION=1024
EMBEDDING_NORMALIZE=true
EMBEDDING_REQUEST_TIMEOUT=60

# RabbitMQ queues
ARTICLE_QUEUE=article.processing
ARTICLE_RETRY_QUEUE=article.processing.retry
ARTICLE_DLQ=article.processing.dlq
ARTICLE_EMBEDDING_QUEUE=article.embedding
ARTICLE_EMBEDDING_RETRY_QUEUE=article.embedding.retry
ARTICLE_EMBEDDING_DLQ=article.embedding.dlq
ARTICLE_RETRY_DELAYS_MS=30000,120000,600000
